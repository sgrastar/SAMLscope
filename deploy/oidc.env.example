# Install as /etc/samlscope/oidc.env with mode 0600, outside the source checkout.
# Leave that file absent to retain the existing authentication configuration.
SAMLSCOPE_OIDC_ISSUER=https://identity.example/tenant
SAMLSCOPE_OIDC_CLIENT_ID=samlscope
SAMLSCOPE_OIDC_CLIENT_SECRET=replace-with-client-secret
SAMLSCOPE_OIDC_ACCESS_POLICY=optional
SAMLSCOPE_OIDC_CLIENT_AUTH_METHOD=client_secret_basic
SAMLSCOPE_OIDC_SIGNING_ALGORITHM=RS256
